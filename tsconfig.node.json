{
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "paths": {
      "@server/*": [
        "server/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    },
    "preserveWatchOutput": true,
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "watchOptions": {
    "excludeDirectories": [
      "node_modules/**"
    ]
  },
  "include": [
    "server/**/*",
    "shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
