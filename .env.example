# Copy to .env.local for local development. Never commit runtime secrets.
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Optional browser API origin. Leave empty to use the Vite /api proxy in development.
VITE_API_BASE_URL=
# Optional local proxy target; defaults to http://127.0.0.1:3000.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
DATABASE_URL=
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
DB_POOL_MAX=10
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
